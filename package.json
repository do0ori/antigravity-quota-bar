{
  "name": "antigravity-quota-bar",
  "displayName": "Antigravity Group Quota Bar",
  "description": "Monitor Gemini and Claude/GPT weekly and five-hour quotas from the status bar.",
  "version": "0.2.2",
  "publisher": "do0ori",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "antigravity",
    "quota",
    "gemini",
    "claude",
    "gpt",
    "status bar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "antigravityQuota.refresh",
        "title": "Antigravity Quota: Refresh"
      }
    ],
    "configuration": {
      "title": "Antigravity Quota Bar",
      "properties": {
        "antigravityQuota.refreshInterval": {
          "type": "integer",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "description": "Auto-refresh interval in seconds for model quota monitoring."
        },
        "antigravityQuota.enableSmartRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh quota shortly after editor code changes or saves."
        }
      }
    }
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/do0ori/antigravity-quota-bar"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --allow-missing-repository",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "publish:env": "npx tsx scripts/publish-all.ts",
    "publish:all": "npm run publish:vscode && npm run publish:openvsx"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.9.1",
    "typescript": "^5.0.0",
    "tsx": "^4.7.0"
  }
}
